{
  "name": "sandflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interaktive 3D-Sand-/Wasser-Erosion im Browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --outDir docs",
    "sim:smoke": "npx --yes vite-node src/sim/erosionSmoke.ts",
    "tools:smoke": "npx --yes vite-node src/sim/toolsSmoke.ts",
    "ui:smoke": "npx --yes vite-node src/ui/aimCursorSmoke.ts",
    "share:smoke": "npx --yes vite-node src/state/shareSmoke.ts",
    "assets:smoke": "npx --yes vite-node src/assets/textureMapsSmoke.ts",
    "water:smoke": "npx --yes vite-node src/scene/waterQualitySmoke.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
